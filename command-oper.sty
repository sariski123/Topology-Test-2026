\newcommand{\retic}[2]{$$% isom. de reticulos A=B
    \left\{\:\text{#1}\:\right\}
    \overset{\sim}{\longleftrightarrow}
    \left\{\:\text{#2}\:\right\}
$$}
\newcommand{\reticc}[3]{$$% isom. de reticulos A=B=C
    \left\{\:\text{#1}\:\right\}
